# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@host:5432/smartup

# ── Authentication ─────────────────────────────────────────────────────────────
# At least 32 random bytes: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-secret

# ── Webhooks ───────────────────────────────────────────────────────────────────
# HMAC-SHA256 key used to sign outgoing webhook payloads
WEBHOOK_SECRET=change-me-webhook-secret

# ── Worker ─────────────────────────────────────────────────────────────────────
# Protects POST /api/worker/deliver from public invocation
WORKER_SECRET=change-me-worker-secret

# Optional: polling interval for the standalone worker process (default 30000ms)
# WORKER_INTERVAL_MS=30000

# ── Soroban contracts ──────────────────────────────────────────────────────────
# Set these after running `pnpm deploy:contract`
NEXT_PUBLIC_CONTRACT_ADDRESS_TESTNET=
NEXT_PUBLIC_CONTRACT_ADDRESS_MAINNET=
